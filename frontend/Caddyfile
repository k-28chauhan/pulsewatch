# One small web server in front of everything:
#   /api/*  -> the Spring Boot app (nothing else of the backend is reachable from outside: not /actuator, not /swagger-ui)
#   others  -> the built React files, with index.html as the fallback so client-side routes like /monitors/5 survive a reload
#
# SITE_ADDRESS decides what Caddy serves:
#   unset or ":80"        plain HTTP (local use)
#   "pulsewatch.example.com"  a real domain: Caddy gets and renews a Let's Encrypt certificate by itself and redirects HTTP to HTTPS
{$SITE_ADDRESS::80} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy {$API_UPSTREAM:app:8080}
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		# The app loads nothing from other sites. 'unsafe-inline' for styles only: React sets a few style="" attributes.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
}
