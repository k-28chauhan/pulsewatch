# Copy to .env (never commit .env) and fill in every line.

# The domain you point at this server (an A record to the server's IP). Caddy gets the HTTPS certificate for it.
DOMAIN=pulsewatch.example.com

# Generate each secret with:  openssl rand -base64 32
POSTGRES_PASSWORD=
# Signs the login tokens. Anyone who knows it can forge a login, so keep it private. At least 32 characters.
JWT_SECRET=

# Where alert emails are sent from. Any SMTP provider works (Brevo, Mailgun, Amazon SES, your own).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM=alerts@example.com
